# ==========================================
# CloudDFS Environment Configuration Example
# ==========================================

# Database Connection (PostgreSQL or SQLite)
# For Supabase/Neon PostgreSQL: postgresql://user:password@ep-xyz.neon.tech/clouddfs?sslmode=require
DATABASE_URL="file:./dev.db"

# Web Frontend & API Base URL
# Point this to your live deployment URL (e.g. https://clouddfs-coordinator.onrender.com) to connect local frontend with live cloud backend!
NEXT_PUBLIC_API_BASE_URL="http://localhost:4000"

# Object Storage Configuration (Cloudflare R2 or AWS S3)
# Leave empty to use local disk storage fallback during offline development!
S3_ENDPOINT="https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
S3_REGION="auto"
S3_ACCESS_KEY_ID="your_r2_access_key_id"
S3_SECRET_ACCESS_KEY="your_r2_secret_access_key"
S3_BUCKET_NAME="clouddfs-data"

# Coordinator & Node Configuration
COORDINATOR_URL="http://localhost:4000"
PORT=4000
ROLE="HYBRID" # COORDINATOR, DATA_NODE, or HYBRID

