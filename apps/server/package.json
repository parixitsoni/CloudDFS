{
  "name": "@clouddfs/server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "dev:coordinator": "node --loader ts-node/esm src/index.ts --role=COORDINATOR --port=4000",
    "dev:node-1": "node --loader ts-node/esm src/index.ts --role=DATA_NODE --node-id=node-us-east-1 --port=4001",
    "dev:node-2": "node --loader ts-node/esm src/index.ts --role=DATA_NODE --node-id=node-eu-west-1 --port=4002",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@clouddfs/database": "1.0.0",
    "@clouddfs/shared": "1.0.0",
    "@clouddfs/storage": "1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.3",
    "multer": "^1.4.5-lts.1",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.11.24",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  }
}
